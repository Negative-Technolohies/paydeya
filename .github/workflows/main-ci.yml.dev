#Это сценарий для CI при PR в main-ветку
name: Main CI

on:
  pull_request:
    branches:
      - main

jobs:

  release-check:

    runs-on: ubuntu-latest

    steps:

      - name: Checkout
        uses: actions/checkout@v4
        with:
          submodules: recursive

      - name: Verify repository
        run: |
          ls -la

      #Простые тесты
      - name: Smoke tests
        run: |
          echo "TODO: Smoke tests"

      #Тест на билды докера

      - name: Backend image build
        run: |
          docker build -t backend:test ./backend
	  echo "## Проверка сформированных образов: ##"
	  docker images

      - name: Backend container run test
	run: |
	  docker run -d --name backend-test backend:test
	  echo "## Sleep 10 ##"
	  sleep 10 
	  echo "## Проверка запущенных контейнеров: ##"
	  docker ps -a

      - name: Frontend image build
        run: |
          docker build -t frontend:test ./frontend
	  echo "## Проверка сформированных образов: ##"
	  docker images

      - name: Frontend container run test
	run: |
	  docker run -d --name frontend-test frontend:test
	  echo "## Sleep 10 ##"
	  sleep 10
	  echo "## Проверка запущенных контейнеров: ##"
	  docker ps -a


      #Проверка работы образа целиком

      - name: Verify images
        run: |
          echo "Image validation"
